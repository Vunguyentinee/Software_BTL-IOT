# KHÔNG sửa file này để đặt mật khẩu thật. Tạo .env bằng:
#   powershell -ExecutionPolicy Bypass -File docker\make-env.ps1     (Linux/macOS: sh docker/make-env.sh)
# Script sinh ngẫu nhiên các khóa bên dưới còn thiếu; .env nằm ngoài git.
#
# --- Tự sinh (bắt buộc, không có giá trị mặc định) ---
# MQTT_BACKEND_PASSWORD=   mật khẩu tài khoản MQTT "backend" (được publish lệnh)
# MQTT_DEVICE_PASSWORD=    mật khẩu tài khoản MQTT "esp32"    (ESP32 thật)
# MQTT_SIM_PASSWORD=       mật khẩu tài khoản MQTT "simulator"
# BTL_JWT_SECRET=          khóa ký JWT, tối thiểu 32 ký tự
# ADMIN_PASSWORD=          mật khẩu tài khoản web/API "admin"
# UI_USERNAME=ui           tài khoản giao diện web tự đăng nhập (operator)
# UI_PASSWORD=
# BTL_USERS=               admin:<mật khẩu>:admin,ui:<mật khẩu>:operator
#
# --- Tùy chọn ---
POSTGRES_USER=smarthome
POSTGRES_PASSWORD=smarthome
POSTGRES_DB=smarthome
DB_PORT=5432
MQTT_PORT=1883
API_PORT=8000
WEB_PORT=3000
